{
  "name": "travel-wallet",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "assets": {
    "directory": "../frontend-template",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travel-wallet",
      "database_id": "<USER_DATABASE_ID>"
    }
  ]
}
